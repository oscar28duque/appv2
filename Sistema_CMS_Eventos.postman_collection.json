			"item": [
				{
					"name": "01 - Login Administrador (Obtener Bearer Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Login exitoso (200 OK)', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Guarda automáticamente el token en las variables', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('token');",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@eventos.com\",\n  \"password\": \"admin123456\"\n}",
							"options": {
