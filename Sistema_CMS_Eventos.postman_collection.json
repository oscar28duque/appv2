				{
					"name": "01 - Cotización Exitosa (200 OK)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code es 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Respuesta contiene estado success', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('success');",
									"    pm.expect(jsonData.data.admin_recipient).to.eql('oscarduquegar@gmail.com');",
									"    pm.expect(jsonData.data.client_recipient).to.eql('juanperez@ejemplo.com');",
